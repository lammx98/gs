@GS.TenantService_HostAddress = http://localhost:5100

### Resolve tenant by code (used by GS.MultiTenant)
GET {{GS.TenantService_HostAddress}}/api/tenants/acme
Accept: application/json

### List all tenants
GET {{GS.TenantService_HostAddress}}/api/tenants
Accept: application/json

### Get by internal id
GET {{GS.TenantService_HostAddress}}/api/tenants/id/11111111-1111-1111-1111-111111111111
Accept: application/json

### Create tenant
POST {{GS.TenantService_HostAddress}}/api/tenants
Content-Type: application/json

{
  "tenantCode": "gamma",
  "tenantName": "Gamma Medical",
  "tier": 0
}

### Update tenant
PUT {{GS.TenantService_HostAddress}}/api/tenants/gamma
Content-Type: application/json

{
  "tenantName": "Gamma Medical Updated",
  "tier": 1,
  "isActive": true
}

### Soft delete tenant
DELETE {{GS.TenantService_HostAddress}}/api/tenants/gamma
